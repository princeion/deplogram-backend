{
  "buildCommand": "npx tsc -p tsconfig.json",
  "devCommand": "npm run start:dev",
  "installCommand": "npm install",
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/docs-json(.*)", "dest": "/api/index.ts" },
    { "src": "/api/docs(.*)", "dest": "/api/index.ts" },
    { "src": "/v1/(.*)", "dest": "/api/index.ts" },
    { "src": "/auth/(.*)", "dest": "/api/index.ts" },
    { "src": "/utils/(.*)", "dest": "/api/index.ts" },
    { "src": "/(.*)", "dest": "/api/index.ts" }
  ]
}
